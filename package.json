{
  "name": "oh-my-agents-above-all",
  "version": "0.2.1-alpha.2.omaa.0.15.0",
  "private": true,
  "type": "module",
  "description": "DSH 五产品深度预设：Codex、Grok Build、Cursor、Pi、ZCode，独立主题与可选 OMD 增强",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "prompts:inspect": "node scripts/inspect-prompts.mjs"
  },
  "files": [
    "src",
    "lib",
    "docs",
    "README.md",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "NOTICE",
    "LICENSING.md"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "@deepseek-ai/dsh": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-alpha.2",
    "esbuild": "0.25.12",
    "playwright": "1.63.0",
    "postcss": "8.5.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.2.2"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./agent": "./src/preset-agent.mjs",
    "./plan-tools": "./src/plan-tools.mjs",
    "./enhancement": "./src/enhancement.mjs",
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./cursor-rules": "./src/cursor-rules.mjs",
    "./checkpoints": "./src/checkpoints.mjs",
    "./working-policy": "./src/working-policy.mjs",
    "./working-tools": "./src/working-tools.mjs",
    "./workflow-controller": "./src/workflow-controller.mjs",
    "./pi-resources": "./src/presets/pi/resources.mjs",
    "./pi-steering": "./src/presets/pi/steering.mjs",
    "./pi-branches": "./src/presets/pi/branches.mjs",
    "./grok-monitor": "./src/presets/grok/monitor.mjs",
    "./grok-scheduler": "./src/presets/grok/scheduler.mjs",
    "./zcode-session-context": "./src/presets/zcode/session-context.mjs",
    "./zcode-workflow": "./src/presets/zcode/workflow.mjs",
    "./pi-extensions": "./src/presets/pi/extensions.mjs",
    "./zcode-typed-workflow": "./src/presets/zcode/typed-workflow.mjs"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.41",
    "clsx": "2.1.1",
    "iconv-lite": "0.7.2",
    "ignore": "7.0.8",
    "jiti": "2.7.0",
    "js-yaml": "4.1.0",
    "lucide-react": "1.17.0",
    "minimatch": "10.2.6",
    "recharts": "3.8.0",
    "semver": "7.8.5",
    "tailwind-merge": "3.5.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-loader": ">=1.0.5 <=1.0.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.28.5"
}
